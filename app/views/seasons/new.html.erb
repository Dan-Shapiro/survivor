<h1>Create a season</h1>

<%= form_with model: @season, local: true do |f| %>
  <% if @season.errors.any? %>
    <div>
      <ul>
        <% @season.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :jury_size %>
    <%= f.number_field :jury_size, value: f.object.jury_size || Season::DEFAULT_JURY_SIZE %>
  </div>

  <%= f.submit "Create season" %>
<% end %>
